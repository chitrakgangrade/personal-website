---
// A hand-stamped seal mark (hanko) -- the site's one recurring graphic
// signature. Pure geometry, no script/language inside it on purpose:
// renders in `currentColor` so any wrapping `text-*` class controls it,
// and the slight rotation is what makes it read as "stamped" rather than
// "drawn with a ruler."
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg viewBox="0 0 40 40" class={className} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <g transform="rotate(-4 20 20)">
    <rect x="3" y="3" width="34" height="34" rx="3" fill="none" stroke="currentColor" stroke-width="3"></rect>
    <rect x="10.5" y="10.5" width="19" height="19" rx="1" fill="currentColor"></rect>
  </g>
</svg>

---
import type { CollectionEntry } from "astro:content";
import Tag from "./Tag.astro";
import { formatDate } from "../utils/formatDate";
import { withBase } from "../utils/url";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
---

<article class="group py-6 first:pt-0">
  <a
    href={withBase(`/blog/${post.id}`)}
    class="block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:focus-visible:outline-accent-dark"
  >
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-serif text-xl font-bold text-stone-900 transition-colors group-hover:text-accent dark:text-stone-100 dark:group-hover:text-accent-dark">
        {title}
      </h2>
      <time datetime={date.toISOString()} class="shrink-0 font-sans text-sm text-stone-400 dark:text-stone-500">
        {formatDate(date)}
      </time>
    </div>
    <p class="mt-2 text-stone-600 dark:text-stone-400">{description}</p>
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <Tag tag={tag} />
          ))}
        </div>
      )
    }
  </a>
</article>

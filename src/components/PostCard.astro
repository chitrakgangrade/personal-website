---
import type { CollectionEntry } from "astro:content";
import Tag from "./Tag.astro";
import { formatDate } from "../utils/formatDate";
import { withBase } from "../utils/url";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
---

<article class="group py-6 first:pt-0">
  <a href={withBase(`/blog/${post.id}`)} class="block">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-serif text-xl text-neutral-900 transition-colors group-hover:text-accent dark:text-neutral-100 dark:group-hover:text-accent-dark">
        {title}
      </h2>
      <time datetime={date.toISOString()} class="shrink-0 text-sm text-neutral-400 dark:text-neutral-500">
        {formatDate(date)}
      </time>
    </div>
    <p class="mt-2 text-neutral-600 dark:text-neutral-400">{description}</p>
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <Tag tag={tag} />
          ))}
        </div>
      )
    }
  </a>
</article>

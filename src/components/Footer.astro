---
import { withBase } from "../utils/url";

// TODO(you): swap in your real email address -- this is a deliberate
// placeholder until then.
const links = [
  { href: "mailto:you@example.com", label: "Email" },
  { href: "https://github.com/chitrakgangrade", label: "GitHub" },
  { href: "https://linkedin.com/in/chitrak-gangrade", label: "LinkedIn" },
  { href: withBase("/rss.xml"), label: "RSS" },
];

const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-2xl px-6 py-12 sm:px-0">
  <div class="flex flex-col gap-4 border-t border-neutral-200 pt-8 font-sans text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between dark:border-neutral-800 dark:text-neutral-400">
    <p>&copy; {year} Chitrak Gangrade.</p>
    <nav class="flex gap-5">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-sm transition-colors hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:hover:text-neutral-100 dark:focus-visible:outline-accent-dark"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

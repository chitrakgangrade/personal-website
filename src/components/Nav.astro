---
import ThemeToggle from "./ThemeToggle.astro";
import { withBase } from "../utils/url";

// TODO(you): swap in your actual name/handle
const SITE_NAME = "Your Name";

const links = [
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
];

const currentPath = Astro.url.pathname;
---

<header class="mx-auto flex max-w-2xl items-center justify-between px-6 py-8 sm:px-0">
  <a
    href={withBase("/")}
    class="font-serif text-lg font-medium text-neutral-900 dark:text-neutral-100"
  >
    {SITE_NAME}
  </a>

  <nav class="flex items-center gap-6">
    {
      links.map((link) => {
        const href = withBase(link.href);
        const isActive = currentPath.startsWith(href);
        return (
          <a
            href={href}
            class:list={[
              "text-sm transition-colors",
              isActive
                ? "text-neutral-900 dark:text-neutral-100"
                : "text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100",
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
    <ThemeToggle />
  </nav>
</header>

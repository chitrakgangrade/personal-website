---
import ThemeToggle from "./ThemeToggle.astro";
import Hanko from "./Hanko.astro";
import { withBase } from "../utils/url";

const SITE_NAME = "Chitrak Gangrade";

const links = [
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
];

const currentPath = Astro.url.pathname;
---

<header class="mx-auto flex max-w-2xl items-center justify-between px-4 py-8 sm:px-0">
  <a
    href={withBase("/")}
    class="flex items-center gap-2.5 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:focus-visible:outline-accent-dark"
  >
    <Hanko class="h-5 w-5 shrink-0 text-accent dark:text-accent-dark" />
    <span class="font-sans text-sm font-bold tracking-[0.12em] text-stone-900 uppercase dark:text-stone-100">
      {SITE_NAME}
    </span>
  </a>

  <nav class="flex items-center gap-5 sm:gap-7">
    {
      links.map((link) => {
        const href = withBase(link.href);
        const isActive = currentPath.startsWith(href);
        return (
          <a
            href={href}
            class:list={[
              "rounded-sm font-sans text-xs font-bold tracking-[0.1em] uppercase transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:focus-visible:outline-accent-dark",
              isActive
                ? "text-accent dark:text-accent-dark"
                : "text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100",
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
    <ThemeToggle />
  </nav>
</header>

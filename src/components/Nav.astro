---
import ThemeToggle from "./ThemeToggle.astro";
import { withBase } from "../utils/url";

const SITE_NAME = "Chitrak Gangrade";

const links = [
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
];

const currentPath = Astro.url.pathname;
---

<header class="mx-auto flex max-w-2xl items-center justify-between px-4 py-8 sm:px-0">
  <a
    href={withBase("/")}
    class="rounded-sm font-serif text-base font-medium text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-lg dark:text-neutral-100 dark:focus-visible:outline-accent-dark"
  >
    {SITE_NAME}
  </a>

  <nav class="flex items-center gap-4 sm:gap-6">
    {
      links.map((link) => {
        const href = withBase(link.href);
        const isActive = currentPath.startsWith(href);
        return (
          <a
            href={href}
            class:list={[
              "rounded-sm font-sans text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:focus-visible:outline-accent-dark",
              isActive
                ? "text-neutral-900 dark:text-neutral-100"
                : "text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100",
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
    <ThemeToggle />
  </nav>
</header>

---
import type { Project } from "../data/projects";
import Tag from "./Tag.astro";
import Hanko from "./Hanko.astro";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { name, tagline, description, mechanism, status, tags, links } = project;

const statusDot: Record<Project["status"], string> = {
  active: "bg-accent dark:bg-accent-dark",
  idea: "bg-stone-300 dark:bg-stone-700",
  archived: "bg-stone-200 dark:bg-stone-800",
};
---

<article class="flex gap-4 border-t border-stone-900 py-10 first:pt-0 sm:gap-6 dark:border-stone-100">
  <span
    aria-hidden="true"
    class="pt-1 font-serif text-6xl leading-none font-bold text-stone-100 tabular-nums select-none sm:text-7xl dark:text-stone-900"
  >
    {String(index + 1).padStart(2, "0")}
  </span>

  <div class="min-w-0 flex-1 pt-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 class="font-serif text-2xl font-bold text-stone-900 dark:text-stone-100">{name}</h2>
      <span class="flex shrink-0 items-center gap-1.5 font-sans text-xs font-bold tracking-wide text-stone-400 uppercase dark:text-stone-500">
        {
          status === "active" ? (
            <Hanko class="h-3.5 w-3.5 text-accent dark:text-accent-dark" />
          ) : (
            <span class:list={["h-1.5 w-1.5 rounded-full", statusDot[status]]} />
          )
        }
        {status}
      </span>
    </div>

    <p class="mt-1 font-serif text-base font-semibold text-stone-500 dark:text-stone-400">{tagline}</p>
    <p class="mt-3 max-w-xl text-stone-700 dark:text-stone-300">{description}</p>

    {
      mechanism && mechanism.length > 0 && (
        <details class="group mt-4">
          <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-sm font-sans text-sm font-semibold text-accent select-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:text-accent-dark dark:focus-visible:outline-accent-dark">
            <span class="inline-block transition-transform group-open:rotate-90">›</span>
            how it works
          </summary>
          <ul class="mt-3 max-w-xl space-y-2.5 border-l-2 border-accent/30 py-1 pl-4 text-sm text-stone-600 dark:border-accent-dark/30 dark:text-stone-400">
            {mechanism.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="mt-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-x-3 gap-y-1">
            {tags.map((tag) => (
              <Tag tag={tag} />
            ))}
          </div>
        )
      }
      {
        links && links.length > 0 && (
          <div class="flex flex-wrap gap-4 font-sans text-sm font-semibold">
            {links.map((link) => {
              const isExternal = link.url.startsWith("http");
              return (
                <a
                  href={link.url}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  class="link-underline rounded-sm text-stone-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent hover:text-accent dark:text-stone-400 dark:hover:text-accent-dark dark:focus-visible:outline-accent-dark"
                >
                  {link.label} ↗
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
</article>

---
import type { Project } from "../data/projects";
import Tag from "./Tag.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, description, status, tags, url } = project;

const statusStyles: Record<Project["status"], string> = {
  active: "bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400",
  idea: "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400",
  archived: "bg-neutral-100 text-neutral-500 dark:bg-neutral-800 dark:text-neutral-400",
};

const isExternal = url?.startsWith("http");
---

<article class="border-b border-neutral-200 py-6 first:pt-0 last:border-b-0 dark:border-neutral-800">
  <div class="flex items-start justify-between gap-4">
    <h2 class="font-serif text-xl text-neutral-900 dark:text-neutral-100">
      {url ? (
        <a
          href={url}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class="transition-colors hover:text-accent dark:hover:text-accent-dark"
        >
          {name}
        </a>
      ) : (
        name
      )}
    </h2>
    <span class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium capitalize ${statusStyles[status]}`}>
      {status}
    </span>
  </div>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <Tag tag={tag} />
        ))}
      </div>
    )
  }
</article>

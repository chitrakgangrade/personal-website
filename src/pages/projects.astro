---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Projects"
  description="Things I've automated so I don't have to think about them -- with the mechanics behind each one."
>
  <div class="flex gap-4 pt-8 sm:pt-16">
    <span aria-hidden="true" class="mt-2.5 h-8 w-1.5 shrink-0 bg-accent dark:bg-accent-dark" />
    <div>
      <h1 class="font-serif text-4xl font-bold text-stone-900 sm:text-5xl dark:text-stone-100">Projects</h1>
      <p class="mt-3 max-w-xl text-stone-600 dark:text-stone-400">
        Not a portfolio -- a working log of things I've built to handle something so I don't have to keep
        doing it by hand. Each one opens up into how it actually works.
      </p>
    </div>
  </div>

  <div class="mt-8 mb-16">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</BaseLayout>

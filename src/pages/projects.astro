---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" description="Things I've built or am building -- AI experiments, strategy docs, side projects.">
  <h1 class="pt-8 font-serif text-3xl font-medium text-neutral-900 sm:pt-16 dark:text-neutral-100">Projects</h1>
  <p class="mt-3 font-sans text-neutral-500 dark:text-neutral-400">
    A running list, not a portfolio. Add new entries in
    <code class="rounded bg-neutral-100 px-1 py-0.5 font-mono text-sm dark:bg-neutral-800">src/data/projects.ts</code>.
  </p>

  <div class="mt-8 mb-16">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { withBase } from "../utils/url";

const interests = ["product strategy", "alpine hiking", "investing", "ai experiments", "japanese history", "writing"];

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Chitrak Gangrade"
  description="Product manager at Booking.com. Writing on product, investing, and AI experiments."
>
  <section class="pt-8 sm:pt-16">
    <h1 class="font-serif text-3xl font-medium text-neutral-900 sm:text-4xl dark:text-neutral-100">
      Hi, I'm Chitrak Gangrade.
    </h1>
    <p class="mt-4 max-w-[65ch] text-lg text-neutral-600 dark:text-neutral-400">
      Product manager working on tax and compliance systems that quietly handle bureaucratic complexity in
      the background.
    </p>
    <p class="mt-2 font-sans text-sm text-neutral-500 dark:text-neutral-500">
      <span class="text-accent dark:text-accent-dark">Currently:</span> Product Manager at Booking.com (tax/compliance),
      based in Amsterdam.
    </p>
  </section>

  <section class="mt-14">
    <h2 class="font-sans text-sm font-medium tracking-wide text-neutral-400 uppercase dark:text-neutral-500">
      What I'm into
    </h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        interests.map((interest) => (
          <li class="rounded-full border border-neutral-200 px-3 py-1 font-sans text-sm text-neutral-600 dark:border-neutral-800 dark:text-neutral-400">
            {interest}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14">
    <h2 class="font-sans text-sm font-medium tracking-wide text-neutral-400 uppercase dark:text-neutral-500">
      About
    </h2>
    <p class="mt-4 max-w-[65ch] text-neutral-600 dark:text-neutral-400">
      Product manager with a background spanning Flipkart (led Flipkart Lite, one of the first large-scale
      commercial Progressive Web Apps), Stripe, and now Booking.com, working on tax and compliance products.
      Believes in "invisible complexity" — systems that handle bureaucratic overhead so users never have to
      think about it. Outside of work: hut-to-hut alpine hiking (Hochkönig/Dachstein region), a long-running
      interest in Japanese history, and systematic equities investing.
    </p>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="mt-14 mb-16">
        <div class="flex items-baseline justify-between">
          <h2 class="font-sans text-sm font-medium tracking-wide text-neutral-400 uppercase dark:text-neutral-500">
            Recent writing
          </h2>
          <a href={withBase("/blog")} class="link-underline font-sans text-sm text-accent dark:text-accent-dark">
            View all
          </a>
        </div>
        <div class="mt-2 divide-y divide-neutral-200 dark:divide-neutral-800">
          {recentPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

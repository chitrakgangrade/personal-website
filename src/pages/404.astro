---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="flex min-h-[50vh] flex-col items-start justify-center pt-8 sm:pt-16">
    <p class="font-sans text-sm text-stone-400 dark:text-stone-500">404</p>
    <h1 class="mt-2 font-serif text-3xl font-medium text-stone-900 sm:text-4xl dark:text-stone-100">
      Nothing here.
    </h1>
    <p class="mt-4 max-w-[50ch] text-stone-600 dark:text-stone-400">
      The page you're looking for doesn't exist, or moved.
    </p>
    <a
      href={withBase("/")}
      class="link-underline mt-6 font-sans text-sm text-accent dark:text-accent-dark"
    >
      &larr; Back home
    </a>
  </section>
</BaseLayout>

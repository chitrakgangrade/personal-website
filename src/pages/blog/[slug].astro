---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";
import { formatDate } from "../../utils/formatDate";
import { withBase } from "../../utils/url";

export async function getStaticPaths() {
  // Draft posts get no page generated for them at all -- not just hidden
  // from the index -- so there's no unlinked-but-live URL for one. Flip a
  // post's `draft: false` when it's ready and it'll appear here too.
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} isArticle publishDate={date}>
  <article class="pt-8 pb-16 sm:pt-16">
    <header class="mb-10">
      <time datetime={date.toISOString()} class="font-sans text-sm text-stone-400 dark:text-stone-500">
        {formatDate(date)}
      </time>
      <h1 class="mt-2 font-serif text-3xl font-bold text-stone-900 sm:text-4xl dark:text-stone-100">
        {title}
      </h1>
      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <Tag tag={tag} />
            ))}
          </div>
        )
      }
    </header>

    <div class="prose prose-neutral mx-auto max-w-[70ch] dark:prose-invert">
      <Content />
    </div>

    <footer class="mt-16 border-t border-stone-200 pt-8 dark:border-stone-800">
      <a href={withBase("/blog")} class="link-underline font-sans text-sm text-accent dark:text-accent-dark">&larr; Back to all posts</a>
    </footer>
  </article>
</BaseLayout>
